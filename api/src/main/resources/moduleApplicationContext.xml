<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	   xsi:schemaLocation="http://www.springframework.org/schema/beans
	   http://www.springframework.org/schema/beans/spring-beans.xsd">
	<!-- Beans to add to the current Application context definition -->

	<!-- Config Serialization Service to be supported by XStream library -->
	<!-- Platform 3.0 removed the serializationServiceTarget bean, so the serializers are added to the serializationService directly -->
	<bean class="org.springframework.beans.factory.config.MethodInvokingBean">
		<property name="targetObject" ref="serializationService"/>
		<property name="targetMethod" value="setSerializers"/>
		<property name="arguments">
			<list>
				<list>
					<ref bean="xstreamSerializer"/>
					<ref bean="xstreamShortSerializer"/>
				</list>
			</list>
		</property>
	</bean>
	<bean id="xstreamShortSerializer" class="org.openmrs.module.serialization.xstream.XStreamShortSerializer"/>
</beans>
